# ==============================================================================
# Distributed E-Commerce Platform - Environment Variables Reference
# ==============================================================================

# Database Credentials
DB_USER=postgres
DB_PASSWORD=password
JWT_SECRET=super-secret-jwt-key

# Database Hosts & Ports
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db

PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5433
PRODUCT_DB_NAME=product_db

ORDER_DB_HOST=localhost
ORDER_DB_PORT=5434
ORDER_DB_NAME=order_db

PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5435
PAYMENT_DB_NAME=payment_db

# Redis & RabbitMQ
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# HTTP Service Ports (External & Cluster)
PORT_GATEWAY=8080
PORT_AUTH=8081
PORT_PRODUCT=8082
PORT_CART=8083
PORT_ORDER=8084
PORT_PAYMENT=8085
PORT_FRONTEND=3000

# Dedicated Internal gRPC Service Ports
AUTH_GRPC_PORT=9091
PRODUCT_GRPC_PORT=9092
CART_GRPC_PORT=9093
ORDER_GRPC_PORT=9094
PAYMENT_GRPC_PORT=9095

# Internal Service Discovery URLs (HTTP)
AUTH_SERVICE_URL=http://auth-service:8081
PRODUCT_SERVICE_URL=http://product-service:8082
CART_SERVICE_URL=http://cart-service:8083
ORDER_SERVICE_URL=http://order-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085

# Internal Service Discovery Addresses (gRPC)
AUTH_SERVICE_GRPC_ADDR=auth-service:9091
PRODUCT_SERVICE_GRPC_ADDR=product-service:9092
CART_SERVICE_GRPC_ADDR=cart-service:9093
ORDER_SERVICE_GRPC_ADDR=order-service:9094
PAYMENT_SERVICE_GRPC_ADDR=payment-service:9095
